# TLS is automatic. api.<domain> → Laravel; ws.<domain> → Reverb (WebSockets).
api.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 110MB
	}
	reverse_proxy api:8030
}

ws.{$DOMAIN} {
	reverse_proxy reverb:8031
}
