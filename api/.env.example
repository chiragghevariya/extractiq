APP_NAME=ExtractIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8030

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=extractiq
DB_USERNAME=extractiq
DB_PASSWORD=secret
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_PORT=8031
REVERB_SERVER_PORT=8031
REVERB_HOST="localhost"
REVERB_APP_ID=extractiq
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret

# --- ExtractIQ -------------------------------------------------------------
FRONTEND_URL=http://localhost:3030
# Sanctum SPA (cookie) auth for the web app
SANCTUM_STATEFUL_DOMAINS=localhost:3030,127.0.0.1:3030
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3030
# local (storage/app) or s3 (MinIO via docker compose, or AWS S3)
DOCUMENTS_DISK=s3
# Analytics: OCR price per page in USD (Textract list prices; pdftext and Tesseract are free)
OCR_COST_TEXTRACT_EXPENSE=0.01
OCR_COST_TEXTRACT_DOCUMENT=0.065
# OCR_DRIVER: pdftext (poppler text layer with word boxes; scans/images fall back to tesseract) | tesseract | textract
OCR_DRIVER=pdftext
TESSERACT_LANG=eng
TESSERACT_PSM=3
# Textract: AnalyzeExpense for invoices, AnalyzeDocument (TABLES+FORMS) otherwise; multi-page PDFs use async jobs
# reading the original from S3 (DOCUMENTS_DISK=s3 on real AWS S3, same region).
TEXTRACT_REGION=us-east-1
TEXTRACT_POLL_SECONDS=5
TEXTRACT_MAX_WAIT_SECONDS=300
# LLM_DRIVER: heuristic (offline, no key) | anthropic | openai
LLM_DRIVER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# ERP_DRIVER: mock | odoo | quickbooks | webhook — the connector used until a company picks one on ERP Sync
ERP_DRIVER=mock
# Push: 5 attempts with these backoffs (seconds), then dead-lettered (push_failed, message shown in the UI)
ERP_PUSH_TRIES=5
ERP_PUSH_BACKOFF=30,120,600,1800
ERP_MOCK_FAIL_EVERY=0
# Odoo 17 (docker compose `odoo`): JSON-RPC. Seed it with `make odoo-seed` (vendors, products, 10 POs).
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=
ODOO_EXPENSE_ACCOUNT=600000
# QuickBooks Online: an OAuth 2.0 app from developer.intuit.com (sandbox). Add QBO_REDIRECT_URI as a redirect URI
# in the app, then use "Connect to QuickBooks" on ERP Sync; tokens are stored encrypted and refreshed automatically.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8030/api/v1/erp/quickbooks/callback
QBO_ENVIRONMENT=sandbox
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
QBO_APP_URL=https://app.sandbox.qbo.intuit.com
QBO_EXPENSE_ACCOUNT_ID=7
# Webhook: POST signed JSON (X-ExtractIQ-Signature: sha256=HMAC of the body) to any URL
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=
# Every extracted field must reach this confidence (and no rule may fail) for status "validated"
REVIEW_CONFIDENCE_THRESHOLD=0.90
REVIEW_SLA_HOURS=24
# The LLM classifies documents the OCR keyword rules couldn't decide; below this it stays unknown
LLM_CLASSIFY_MIN_CONFIDENCE=0.6
AUTO_APPROVE_VALIDATED=false
# Matching defaults for every company (each company can override them in Settings → Matching tolerances).
# Unit price may differ by the larger of the % and the amount; amounts are in major units of the invoice currency.
MATCH_PRICE_TOLERANCE_PCT=2
MATCH_PRICE_TOLERANCE_ABS=0.05
MATCH_QTY_TOLERANCE_PCT=0
MATCH_TOTAL_TOLERANCE_ABS=5
# auto (3-way once goods are received) | two_way | three_way
MATCH_MODE=auto
# Who may accept a variance: admin | reviewer (= admins and reviewers)
MATCH_ACCEPT_ROLE=admin
# Inbound email: every company gets ap-{slug}@INBOUND_EMAIL_DOMAIN; mailbox polled every minute
INBOUND_EMAIL_DOMAIN=inbound.extractiq.test
INBOUND_MAIL_DRIVER=mailpit
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
PAGE_IMAGE_DPI=300
INBOUND_EMAIL_SECRET=
MAILPIT_API_URL=http://127.0.0.1:8025

# MinIO (docker compose) — set DOCUMENTS_DISK=s3 to use it
AWS_ACCESS_KEY_ID=extractiq
AWS_SECRET_ACCESS_KEY=extractiq-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=extractiq
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true


# ---- Phase 8: security, demo, health ------------------------------------------------------
# Lifetime (seconds) of signed links to originals and page images (presigned S3 or signed route).
SIGNED_URL_TTL=300
# Requests per minute per user (or per IP when signed out).
RATE_LIMIT_API=600
RATE_LIMIT_UPLOADS=30
RATE_LIMIT_EXPORTS=10
RATE_LIMIT_LOGIN=10
# Public demo: POST /auth/demo signs visitors in read-only; extractiq:demo-reset reseeds nightly.
# On a public demo the named seed accounts get random passwords. Never enable on a real tenant.
DEMO_MODE=false
DEMO_COMPANY=demo
DEMO_USER_EMAIL=demo@extractiq.test
DEMO_RESET_AT=03:30
APP_VERSION=1.0.0
